# =========================================================
# AGENT-CORE - Git Ignore
# =========================================================

# -------------------------
# Node.js dependencies
# -------------------------
node_modules/
**/node_modules/

# -------------------------
# Build / compiled output
# -------------------------
dist/
build/
out/

# Compiled executables
*.exe
*.dll

# Native Node.js modules
*.node

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# Local configuration containing secrets
config.local.json
config.production.json
secrets.json
credentials.json

# -------------------------
# Runtime data
# -------------------------
queue.json
*.queue.json

# -------------------------
# Database files
# -------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Temporary files
# -------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# -------------------------
# Cache
# -------------------------
.cache/
.npm/
.eslintcache

# -------------------------
# VS Code
# -------------------------
.vscode/
*.code-workspace

# -------------------------
# JetBrains IDE
# -------------------------
.idea/
*.iml

# -------------------------
# Windows
# -------------------------
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# -------------------------
# macOS
# -------------------------
.DS_Store
.AppleDouble
.LSOverride

# -------------------------
# Installer generated files
# -------------------------
installer/*.exe
installer/*.node

# -------------------------
# Daemon generated/build files
# -------------------------
daemon/dist/
daemon/build/

# -------------------------
# Coverage / Testing
# -------------------------
coverage/
.nyc_output/

# -------------------------
# Process files
# -------------------------
*.pid
*.pid.lock
pids/

# -------------------------
# Package manager cache
# -------------------------
.npm/
.yarn/
.pnpm-store/